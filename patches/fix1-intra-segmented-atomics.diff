+/*
+Modified by Lu Verissimo, 2026-11-04 (independent performance study, not affiliated with or
+endorsed by Scripps Research): intramolecular-gradient accumulation onto atom1 uses one
+shared-memory atomic per run of equal atom IDs within a warp (segmented warp reduction)
+instead of one atomic per pair. Integer (fixed-point) gradients make the result identical.
+Build with -DINTRA_ATOMICS_LEGACY to restore the original per-pair atomics.
+*/
+
 
 // IMPORTANT: The following block contains definitions
 // already made either in energy or gradient calculation files.
@@ -45,6 +53,57 @@ Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301  USA
 // Currently, this is not a good idea
 // #define RESTORING_MAP_GRADIENT
 
+#if !defined(FLOAT_GRADIENTS) && !defined(REPRO) && !defined(INTRA_ATOMICS_LEGACY)
+#define INTRA_SEGMENTED_ATOMICS
+#endif
+
+#ifdef INTRA_SEGMENTED_ATOMICS
+// [Lu Verissimo 2026-11-04] Segmented warp reduction for the atom1 gradient update.
+// The host builds the intramolecular pair list atom1-major (calcenergy.cpp), and lane i of a
+// warp handles list entry base+i, so pairs sharing atom1 occupy contiguous lanes. Each run of
+// equal keys is summed with a segmented inclusive scan (Hillis-Steele with head flags) and
+// only the last lane of the run issues the atomic. Correct for any key order (repeats that
+// are not contiguous just form separate runs); only the speed depends on contiguity.
+// Values are fixed-point ints, so the sum, and hence the gradient, is identical to the
+// per-pair atomics. Must be called by all lanes of the warp (warp-uniform control flow).
+// Inactive lanes pass key = 0xFFFFFFFF and zero values. Lane/width come from the runtime
+// warp mask, so no warp size is hard-coded; the shuffle mask is the 32-lane CUDA one.
+#define INTRA_FULL_MASK 0xffffffffu
+#define INTRA_NO_ATOM   0xffffffffu
+__device__ __forceinline__ void intra_segmented_atomic_sub(
+                                                           int3*    gradient,
+                                                           uint32_t key,
+                                                           int      vx,
+                                                           int      vy,
+                                                           int      vz
+                                                          )
+{
+	const uint32_t lane  = threadIdx.x & cData.warpmask;
+	const uint32_t width = cData.warpmask + 1;
+	const uint32_t prev  = __shfl_up_sync(INTRA_FULL_MASK, key, 1);
+	int head = (lane == 0) || (prev != key);
+	for (uint32_t off = 1; off < width; off <<= 1)
+	{
+		const int ux = __shfl_up_sync(INTRA_FULL_MASK, vx, off);
+		const int uy = __shfl_up_sync(INTRA_FULL_MASK, vy, off);
+		const int uz = __shfl_up_sync(INTRA_FULL_MASK, vz, off);
+		const int uh = __shfl_up_sync(INTRA_FULL_MASK, head, off);
+		if ((lane >= off) && !head)
+		{
+			vx += ux; vy += uy; vz += uz;
+			head = uh;
+		}
+	}
+	const uint32_t next = __shfl_down_sync(INTRA_FULL_MASK, key, 1);
+	if ((key != INTRA_NO_ATOM) && ((lane == cData.warpmask) || (next != key)))
+	{
+		ATOMICSUBI32(&gradient[key].x, vx);
+		ATOMICSUBI32(&gradient[key].y, vy);
+		ATOMICSUBI32(&gradient[key].z, vz);
+	}
+}
+#endif
+
 __device__ void gpu_calc_energrad(
                                   float*  genotype,
                                   float&  global_energy,
@@ -426,6 +485,19 @@ __device__ void gpu_calc_energrad(
