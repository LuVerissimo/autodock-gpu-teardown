 	// Simplest way to ensure random order of atomic addition doesn't make answers irreproducible: use only 1 thread
 	if (threadIdx.x==0) for (uint32_t contributor_counter = 0; contributor_counter < cData.dockpars.num_of_intraE_contributors; contributor_counter+= 1) {
+#elif defined(INTRA_SEGMENTED_ATOMICS)
+	// [Lu Verissimo 2026-11-04] Warp-uniform trip count (a warp iterates while its first lane
+	// has work) so every lane reaches the warp shuffles; lanes past the end skip the body.
+	// Each lane still processes exactly the same pairs as before.
+	const uint32_t intra_lane = threadIdx.x & cData.warpmask;
+	for (uint32_t contributor_counter = threadIdx.x;
+	              (contributor_counter - intra_lane) < cData.dockpars.num_of_intraE_contributors;
+	              contributor_counter+= blockDim.x) {
+		int      seg_gx    = 0;
+		int      seg_gy    = 0;
+		int      seg_gz    = 0;
+		uint32_t seg_atom1 = INTRA_NO_ATOM;
+		if (contributor_counter < cData.dockpars.num_of_intraE_contributors) {
 #else 
 	for (uint32_t contributor_counter = threadIdx.x;
 	              contributor_counter < cData.dockpars.num_of_intraE_contributors;
@@ -584,14 +656,25 @@ __device__ void gpu_calc_energrad(
 		ATOMICADDF32(&gradient[atom2_id].x, priv_intra_gradient_x);
 		ATOMICADDF32(&gradient[atom2_id].y, priv_intra_gradient_y);
 		ATOMICADDF32(&gradient[atom2_id].z, priv_intra_gradient_z);
+#else
+#ifdef INTRA_SEGMENTED_ATOMICS
+		seg_gx    = priv_intra_gradient_x;
+		seg_gy    = priv_intra_gradient_y;
+		seg_gz    = priv_intra_gradient_z;
