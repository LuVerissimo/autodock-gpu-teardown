+#ifdef USE_SHFL_REDUCE
+// [Lu Verissimo 2026-11-04] Block-wide sum of four floats; every thread receives the result.
+// 1) xor-butterfly inside each warp (fixed order, all lanes get the warp sum),
+// 2) lane 0 of each warp stores its four sums in `partial`, one barrier,
+// 3) every thread adds the per-warp partials in warp order 0..n-1 itself (fixed order, so the
+//    result is bit-identical across threads and across runs; no second barrier).
+// `partial` must hold 4 * (blockDim.x / warp width) floats and must not be shared with another
+// call site that can run before every thread has read it (each call site gets its own buffer;
+// the barriers of the following call sites protect reuse in the next evaluation).
+// Requires blockDim.x to be a multiple of the warp width (NUMWI >= 32).
+#define SHFL_FULL_MASK 0xffffffffu
+__device__ __forceinline__ void block_reduce4_shfl(
+                                                   float& a,
+                                                   float& b,
+                                                   float& c,
+                                                   float& d,
+                                                   float* partial
+                                                  )
+{
+	for (uint32_t off = (cData.warpmask + 1) >> 1; off > 0; off >>= 1)
+	{
+		a += __shfl_xor_sync(SHFL_FULL_MASK, a, off);
+		b += __shfl_xor_sync(SHFL_FULL_MASK, b, off);
+		c += __shfl_xor_sync(SHFL_FULL_MASK, c, off);
+		d += __shfl_xor_sync(SHFL_FULL_MASK, d, off);
+	}
+	const uint32_t warp = threadIdx.x >> cData.warpbits;
+	if ((threadIdx.x & cData.warpmask) == 0)
+	{
+		partial[4*warp]     = a;
+		partial[4*warp + 1] = b;
+		partial[4*warp + 2] = c;
+		partial[4*warp + 3] = d;
+	}
+	__syncthreads();
+	const uint32_t nwarps = blockDim.x >> cData.warpbits;
+	a = partial[0]; b = partial[1]; c = partial[2]; d = partial[3];
+	for (uint32_t w = 1; w < nwarps; w++)
+	{
+		a += partial[4*w];
+		b += partial[4*w + 1];
+		c += partial[4*w + 2];
+		d += partial[4*w + 3];
+	}
+}
+#endif
